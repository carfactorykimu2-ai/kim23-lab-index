---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugifyMagazine } from '../../lib/slug';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	const names = new Set<string>();
	for (const a of articles) {
		for (const m of a.data.magazine) names.add(m);
	}
	return [...names].map((name) => ({
		params: { magazine: slugifyMagazine(name) },
		props: { name },
	}));
}

const { name } = Astro.props;
const base = import.meta.env.BASE_URL;

const allArticles = await getCollection('articles');
const articles = allArticles
	.filter((a) => a.data.magazine.includes(name))
	.sort((a, b) => {
		const stepA = a.data.step ?? '';
		const stepB = b.data.step ?? '';
		if (stepA !== stepB) return stepA.localeCompare(stepB, 'ja', { numeric: true });
		const da = a.data.date?.getTime() ?? 0;
		const db = b.data.date?.getTime() ?? 0;
		return da - db;
	});
---
<Base title={name} description={`マガジン「${name}」の記事一覧`}>
	<p><a href={`${base}magazines/`}>&larr; Magazines</a></p>
	<h1>{name}</h1>
	<p class="muted">{articles.length}記事</p>
	<ul>
		{articles.map((article) => (
			<li>
				{article.data.step && <span class="chip">{article.data.step}</span>}
				<a href={`${base}articles/${article.id}/`}>{article.data.title}</a>
			</li>
		))}
	</ul>
</Base>
