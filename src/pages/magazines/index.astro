---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugifyMagazine } from '../../lib/slug';

const base = import.meta.env.BASE_URL;
const articles = await getCollection('articles');

const counts = new Map<string, number>();
for (const a of articles) {
	for (const m of a.data.magazine) {
		counts.set(m, (counts.get(m) ?? 0) + 1);
	}
}
const magazines = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---
<Base title="Magazines" description="マガジン別の記事一覧。">
	<h1>Magazines</h1>
	<p class="muted">{magazines.length}件のマガジン。記事数の多い順に表示しています。</p>
	<ul>
		{magazines.map(([magazine, count]) => (
			<li>
				<a href={`${base}magazines/${slugifyMagazine(magazine)}/`}>{magazine}</a>
				<span class="muted"> ({count}記事)</span>
			</li>
		))}
	</ul>
</Base>
