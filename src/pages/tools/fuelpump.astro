<style is:global>
#fpx{
  --card:var(--bg);--ink:var(--fg);--sub:var(--muted);--line:var(--border);--field:var(--chip-bg);--acc:var(--accent);
  --ok:#1a7f37;--warn:#b26b00;--ng:#cf222e;
  --c-hi:#1f6feb;--c-lo:#e8590c;--c-los:#f2a46b;--c-use:#7048e8;--c-mk:#2b8a3e;--c-mk2:#c92a2a;
  line-height:1.65;font-size:1rem;
}
@media (prefers-color-scheme:dark){
  #fpx{--ok:#3fb950;--warn:#d29922;--ng:#f85149;
    --c-hi:#58a6ff;--c-lo:#ff922b;--c-los:#a9643a;--c-use:#b197fc;--c-mk:#51cf66;--c-mk2:#ff6b6b;}
}
#fpx *{box-sizing:border-box}
#fpx h2{font-size:1.15em;margin:0 0 12px;padding-bottom:6px;border-bottom:1px solid var(--line)}
#fpx h3{font-size:.95em;margin:14px 0 4px;color:var(--sub)}
#fpx .lead{color:var(--sub);margin:0 0 18px;font-size:.95em}
#fpx .card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin-top:14px}
#fpx .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:0 28px}
#fpx .row{display:grid;grid-template-columns:1fr 130px;align-items:center;gap:8px;margin:7px 0}
#fpx .row label{font-size:1em}
#fpx .row small{display:block;color:var(--sub);font-size:.84em;line-height:1.35;margin-top:2px}
#fpx input,#fpx select{width:100%;padding:7px 9px;font-size:1em;border:1px solid var(--line);border-radius:6px;background:var(--field);color:var(--ink);font-family:inherit}
#fpx input{text-align:right}
#fpx input[type=checkbox]{width:auto;margin-right:6px;vertical-align:middle}
#fpx input:focus,#fpx select:focus{outline:2px solid var(--acc);outline-offset:-1px}
#fpx details{margin-top:14px;border-top:1px solid var(--line);padding-top:10px}
#fpx summary{cursor:pointer;font-weight:600;font-size:1em}
#fpx .chk{font-size:1em;margin:12px 0 2px;display:block}
#fpx .hide{display:none}
#fpx .big{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-bottom:14px}
#fpx .kpi{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--field)}
#fpx .kpi .k{font-size:.92em;color:var(--sub)}
#fpx .kpi .v{font-size:2.1em;font-weight:700;font-variant-numeric:tabular-nums}
#fpx .kpi .v span{font-size:.5em;font-weight:500;margin-left:4px}
#fpx .kpi .n{font-size:.88em;color:var(--sub)}
#fpx table{width:100%;border-collapse:collapse;font-size:.95em;font-variant-numeric:tabular-nums}
#fpx td{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left}
#fpx td.r{text-align:right;white-space:nowrap}
#fpx .badge{display:inline-block;padding:1px 8px;border-radius:99px;font-size:.82em;font-weight:600;color:#fff}
#fpx .b-ok{background:var(--ok)}#fpx .b-warn{background:var(--warn)}#fpx .b-ng{background:var(--ng)}
#fpx .msgs div{padding:8px 10px;border-radius:6px;margin:6px 0;font-size:.95em;border-left:4px solid}
#fpx .m-warn{border-color:var(--warn);background:color-mix(in srgb,var(--warn) 10%,transparent)}
#fpx .m-ng{border-color:var(--ng);background:color-mix(in srgb,var(--ng) 10%,transparent)}
#fpx .m-info{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 8%,transparent)}
#fpx .chart svg{width:100%;height:auto;display:block}
#fpx .chart .grid-l{stroke:var(--line);stroke-width:1}
#fpx .chart .axis{stroke:var(--sub);stroke-width:1}
#fpx .chart .tick{fill:var(--sub);font-size:13px}
#fpx .chart .lab{fill:var(--sub);font-size:14px}
#fpx .legend{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:.9em;color:var(--sub);margin-top:4px}
#fpx .legend i{display:inline-block;width:18px;height:0;border-top:3px solid;vertical-align:middle;margin-right:5px}
#fpx .legend i.d{border-top-style:dashed}
#fpx .formula{font-size:.95em}
#fpx .formula code{background:var(--field);border:1px solid var(--line);border-radius:4px;padding:1px 5px;font-size:.9em}
#fpx .formula li{margin:5px 0}
#fpx .note{color:var(--sub);font-size:.84em}
@media (max-width:480px){#fpx .row{grid-template-columns:1fr 110px}#fpx .kpi .v{font-size:1.8em}}
</style>
