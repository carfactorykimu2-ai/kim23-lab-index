---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MagazineCards from '../components/MagazineCards.astro';
import WaveTrace from '../components/WaveTrace.astro';

const base = import.meta.env.BASE_URL;
const articles = await getCollection('articles');

const sorted = [...articles].sort((a, b) => {
	const da = a.data.date?.getTime() ?? 0;
	const db = b.data.date?.getTime() ?? 0;
	return db - da;
});
const latest = sorted.slice(0, 8);

const magazineCounts = new Map<string, number>();
for (const a of articles) {
	for (const m of a.data.magazine) {
		magazineCounts.set(m, (magazineCounts.get(m) ?? 0) + 1);
	}
}
const topMagazines = [...magazineCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
---
<Base title="Home" description="ECU/CANチューニングの知見を記事・マガジン単位で整理し、全文検索できるインデックスサイト。">
	<section class="hero" style={`--hero-img: url(${base}images/hero/link-g4-board.webp)`}>
		<WaveTrace class="hero-trace" />
		<div class="hero-text">
			<p class="hero-kicker">ECU / CAN / DATA LOGGING</p>
			<h1>kim23-lab-index</h1>
			<p>ECUフルコン化・CAN解析・車両データ計測に関する記事を、マガジン別に整理し、メタデータから横断検索できるインデックスサイトです。記事本文は <a href="https://note.com/labratory_ktech" target="_blank" rel="noopener noreferrer">note.com</a> 上で公開しています。</p>
		</div>
	</section>

	<p>
		<a class="chip" href={`${base}magazines/`}>📚 Magazines ({magazineCounts.size})</a>
		<a class="chip" href={`${base}articles/`}>📄 Articles ({articles.length})</a>
		<a class="chip" href={`${base}search/`}>🔍 Search</a>
		<a class="chip" href={`${base}tools/`}>🛠 Tools</a>
		<a class="chip" href={`${base}data/`}>📊 Data</a>
	</p>

	<h2>よく読まれているマガジン</h2>
	<MagazineCards magazines={topMagazines} />

	<h2>最新の記事</h2>
	<ul>
		{latest.map((article) => (
			<li>
				<a href={`${base}articles/${article.id}/`}>{article.data.title}</a>
				{article.data.date && <span class="muted"> — {article.data.date.toISOString().slice(0, 10)}</span>}
			</li>
		))}
	</ul>
</Base>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		margin: 0 0 1.25rem;
		padding: 3.5rem 1.5rem 3rem;
		color: #f2f5f8;
		background:
			linear-gradient(100deg, rgba(8, 12, 18, 0.92) 0%, rgba(8, 12, 18, 0.72) 55%, rgba(8, 12, 18, 0.35) 100%),
			var(--hero-img) center / cover no-repeat,
			#0b1118;
	}
	.hero :global(.hero-trace) {
		top: auto;
		height: 45%;
		opacity: 0.55;
	}
	.hero-text {
		position: relative;
		max-width: 34rem;
	}
	.hero-kicker {
		margin: 0;
		font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		color: #4fd1ff;
	}
	.hero h1 {
		margin: 0.2rem 0 0.6rem;
		font-size: clamp(1.8rem, 6vw, 2.6rem);
		line-height: 1.15;
	}
	.hero p:not(.hero-kicker) {
		margin: 0;
		font-size: 0.92rem;
		color: #c9d2db;
	}
	.hero a { color: #8fd3ff; }
</style>
