---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugifyMagazine } from '../../lib/slug';

const base = import.meta.env.BASE_URL;

const articles = (await getCollection('articles')).sort((a, b) => {
	const da = a.data.date?.getTime() ?? 0;
	const db = b.data.date?.getTime() ?? 0;
	return db - da;
});
---
<Base title="Articles" description="全記事一覧。">
	<h1>Articles</h1>
	<p class="muted">{articles.length}記事。メタデータからの絞り込みは <a href={`${base}search/`}>Search</a> をご利用ください。</p>
	<ul>
		{articles.map((article) => (
			<li>
				<a href={`${base}articles/${article.id}/`}>{article.data.title}</a>
				<div class="muted">
					{article.data.date && <span>{article.data.date.toISOString().slice(0, 10)}</span>}
					{article.data.car_model && <span> ・ {article.data.car_model}</span>}
					{article.data.ecu.length > 0 && <span> ・ {article.data.ecu.join(' / ')}</span>}
				</div>
				{article.data.magazine.map((m) => (
					<a class="chip" href={`${base}magazines/${slugifyMagazine(m)}/`}>{m}</a>
				))}
			</li>
		))}
	</ul>
</Base>
