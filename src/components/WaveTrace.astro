---
/** データロガーの波形画面っぽい装飾 (グリッド + RPM 風/パルス風のトレース)。親要素いっぱいに広がる。 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---
<svg class:list={['wave-trace', className]} viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true">
	<defs>
		<pattern id="wave-grid" width="20" height="20" patternUnits="userSpaceOnUse">
			<path d="M20 0H0V20" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.25" />
		</pattern>
	</defs>
	<rect width="400" height="100" fill="url(#wave-grid)" />
	<path
		class="trace-a"
		d="M0 78 C30 78 40 70 60 62 S90 40 110 44 S140 70 160 66 S200 24 230 20 S270 30 290 46 S320 74 340 68 S380 36 400 30"
		fill="none"
		stroke-width="1.6"
		vector-effect="non-scaling-stroke"
	/>
	<path
		class="trace-b"
		d="M0 90 H24 V82 H30 V90 H74 V82 H80 V90 H124 V82 H130 V90 H174 V82 H180 V90 H224 V82 H230 V90 H274 V82 H280 V90 H324 V82 H330 V90 H374 V82 H380 V90 H400"
		fill="none"
		stroke-width="1.2"
		vector-effect="non-scaling-stroke"
	/>
</svg>

<style>
	.wave-trace {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		color: #8fd3ff;
		pointer-events: none;
	}
	.trace-a { stroke: #4fd1ff; }
	.trace-b { stroke: #ffb347; opacity: 0.8; }
</style>
