---
import WaveTrace from './WaveTrace.astro';
import { magazineImage } from '../lib/magazineImages';
import { slugifyMagazine } from '../lib/slug';

interface Props {
	/** [マガジン名, 記事数] の並び */
	magazines: [string, number][];
}
const { magazines } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="mag-cards">
	{magazines.map(([magazine, count]) => {
		const image = magazineImage(magazine, base);
		return (
			<li>
				<a href={`${base}magazines/${slugifyMagazine(magazine)}/`}>
					<div class="thumb">
						{image ? <img src={image} alt="" loading="lazy" width="640" height="400" /> : <WaveTrace />}
					</div>
					<div class="body">
						<span class="name">{magazine}</span>
						<span class="muted count">{count}記事</span>
					</div>
				</a>
			</li>
		);
	})}
</ul>

<style>
	.mag-cards {
		list-style: none;
		padding: 0;
		margin: 1rem 0 1.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
		gap: 0.9rem;
	}
	.mag-cards a {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
		color: var(--fg);
		background: var(--bg);
		transition: border-color 0.15s, transform 0.15s;
	}
	.mag-cards a:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.thumb {
		position: relative;
		aspect-ratio: 16 / 10;
		background: #0f1720;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.body {
		display: flex;
		flex-direction: column;
		padding: 0.55rem 0.75rem 0.7rem;
		line-height: 1.45;
	}
	.name { font-weight: 600; font-size: 0.92rem; }
	.count { font-size: 0.8rem; }
	@media (max-width: 540px) {
		.mag-cards { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
		.body { padding: 0.4rem 0.55rem 0.5rem; }
		.name { font-size: 0.8rem; }
	}
</style>
