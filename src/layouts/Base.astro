---
interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;

const navItems = [
	{ href: base, label: 'Home' },
	{ href: `${base}magazines/`, label: 'Magazines' },
	{ href: `${base}articles/`, label: 'Articles' },
	{ href: `${base}search/`, label: 'Search' },
	{ href: `${base}tools/`, label: 'Tools' },
	{ href: `${base}data/`, label: 'Data' },
];
---
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title} | kim23-lab-index</title>
		<style is:global>
			:root {
				color-scheme: light dark;
				--fg: #1a1a1a;
				--bg: #ffffff;
				--muted: #666666;
				--border: #dddddd;
				--accent: #0b5fff;
				--chip-bg: #f0f2f5;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--fg: #e8e8e8;
					--bg: #14161a;
					--muted: #9aa0a6;
					--border: #333740;
					--accent: #6aa9ff;
					--chip-bg: #23262d;
				}
			}
			* { box-sizing: border-box; }
			html { font-size: 112.5%; }
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
				font-family: system-ui, -apple-system, "Segoe UI", "Hiragino Kaku Gothic ProN", sans-serif;
				line-height: 1.7;
			}
			a { color: var(--accent); }
			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1rem;
				padding: 0.75rem 1.25rem;
				border-bottom: 1px solid var(--border);
				position: sticky;
				top: 0;
				background: var(--bg);
				z-index: 10;
			}
			nav a { text-decoration: none; font-weight: 600; font-size: 0.95rem; }
			main {
				max-width: 860px;
				margin: 0 auto;
				padding: 1.5rem 1.25rem 4rem;
			}
			.chip {
				display: inline-block;
				font-size: 0.8rem;
				padding: 0.15rem 0.6rem;
				border-radius: 999px;
				background: var(--chip-bg);
				color: var(--fg);
				text-decoration: none;
				margin: 0.15rem 0.25rem 0.15rem 0;
			}
			.muted { color: var(--muted); }
			dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; margin: 1.25rem 0; }
			dl.meta dt { color: var(--muted); font-size: 0.85rem; }
			dl.meta dd { margin: 0; }
		</style>
	</head>
	<body>
		<nav>
			{navItems.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</nav>
		<main>
			<slot />
		</main>
	</body>
</html>
